# Copy to .env for local work. In production every one of these is set in the
# Vercel project's Environment Variables (Production + Preview), then redeployed —
# see MIGRATION-PLAYBOOK.md §5.4.
#
# The site builds and deploys with all of them missing. The form then stores
# nothing and sends nothing, and src/lib/turnstile.ts logs a loud warning that
# CAPTCHA verification is being skipped. That is deliberate: it lets the clone go up
# for client review before the services in §5 exist.

# --- Database (playbook §5.1) -------------------------------------------------
# Injected automatically by the Neon integration on Vercel. Do not set it by hand
# there. Locally, paste a Neon connection string to test against a real database.
DATABASE_URL=

# --- Email (playbook §5.2) ----------------------------------------------------
# Postmark server token for this client's own Postmark Server.
POSTMARK_SERVER_TOKEN=
# Must be an address on a domain verified in Postmark (DKIM + Return-Path).
POSTMARK_FROM_EMAIL=noreply@plumberfranklintn.com
# Where leads are delivered. BlendMode's own support address, not the client's:
# this is a dev-only engagement, so the notifications land with the agency.
SITE_OWNER_EMAIL=support@blendmode.com

# --- CAPTCHA (playbook §5.3) --------------------------------------------------
# Cloudflare Turnstile, widget mode "Managed", hostnames: plumberfranklintn.com,
# www.plumberfranklintn.com and the *.vercel.app preview domain.
TURNSTILE_SECRET_KEY=
# The only value here that may reach the browser.
PUBLIC_TURNSTILE_SITE_KEY=
#
# Cloudflare's official test keys, for local work without burning real challenges:
#   site   1x00000000000000000000AA
#   secret 1x0000000000000000000000000000000AA   (always passes)
#          2x0000000000000000000000000000000AA   (always fails)

# --- Privacy ------------------------------------------------------------------
# Any long random string; `openssl rand -hex 32`. Salts the one-way hash of the
# submitter's IP. The raw address is never stored.
IP_HASH_SALT=

# --- Feature flags (playbook §4c step 7) --------------------------------------
# Only needed when you want behaviour other than the default. Redeploy after
# changing one.
# STORE_FORM_DATA_TO_DB=true      # default true  — Neon is the source of truth
# SEND_EMAIL_TO_SITE_OWNER=true   # default true  — the lead notification
# SEND_EMAIL_TO_CUSTOMER=false    # default false — needs copy the client approved

# --- Build-time switches ------------------------------------------------------
# PUBLIC_SITE_URL=https://plumberfranklintn.com   # canonical origin
# PUBLIC_WEBFONTS=on                              # link Elementor's Ledger + Lato
# PUBLIC_APPLY_FIXES=on                           # build with src/lib/fixes.ts applied
